# Merchant gateway base URL
MERCHANT_API_BASE_URL=https://merchant.example.com

# Optional bearer token for merchant APIs
MERCHANT_API_KEY=

# Optional custom route paths
MERCHANT_CREATE_ORDER_PATH=/x402/create-order
MERCHANT_ORDER_STATUS_PATH=/x402/order-status/:paymentId
MERCHANT_SUBMIT_SIGNATURE_PATH=/x402/submit-signature
MERCHANT_CANCEL_ORDER_PATH=/x402/cancel-order

# x402 Merchant Portal API base URL (distinct from merchant gateway)
MERCHANT_PORTAL_BASE_URL=http://localhost:8080

# Idempotency store mode: memory | redis
AGENTKIT_IDEMPOTENCY_MODE=memory
# Used when AGENTKIT_IDEMPOTENCY_MODE=redis
AGENTKIT_REDIS_URL=redis://127.0.0.1:6379

# --- Giftcard plugin (production-only config) ---
GIFTCARD_API_BASE_URL=https://giftcard-api.goat.network
GIFTCARD_AUTH_DOMAIN_NAME=GiftCard
GIFTCARD_AUTH_DOMAIN_VERSION=1
GIFTCARD_AUTH_DOMAIN_CHAIN_ID=2345

# --- GNS plugin (production-only config) ---
# GOAT Network mainnet
GNS_API_BASE_URL=https://gns-api.goat.network/api

# --- GOAT Flow API (x402 payments via GoatAdapter; formerly GoatX402) ---
# Merchant API credentials; obtain from the GOAT Flow merchant/admin portal.
GOAT_X402_API_KEY=
GOAT_X402_API_SECRET=
# Optional base URL override. Defaults per network when unset:
#   goat-mainnet -> https://flow-api.goat.network
#   goat-testnet -> https://flow-api.testnet3.goat.network
# Bare HTTPS origin only (no path, query, or fragment); loopback HTTP is allowed for local development.
# GOAT_X402_BASE_URL=


# --- Public GOAT Flow PayKit CLI (no merchant HMAC credentials required) ---
# Public links use flow-quickpay[.testnet3].goat.network, not flow-api.
PAYKIT_PRIVATE_KEY=
# PAYKIT_RPC_URL=https://your-evm-rpc.example
# Per-chain RPC takes precedence over PAYKIT_RPC_URL; --rpc-url overrides both.
# PAYKIT_RPC_4217=https://your-chain-rpc.example
# Private, durable journal; retain it across retries and process restarts.
# PAYKIT_STATE_DIR=/private/agent-state/paykit
# Optional existing, private emergency parent outside PAYKIT_STATE_DIR (prefer another filesystem).
# PAYKIT_EMERGENCY_DIR=/other-volume/private-agent-recovery
