{
  "name": "@goatnetwork/agentkit",
  "version": "0.3.0",
  "description": "TypeScript SDK enabling AI Agents to autonomously execute on-chain operations on GOAT Network",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentkit-gns": "./bin/gns.mjs",
    "agentkit-giftcard": "./bin/giftcard.mjs",
    "agentkit-paykit": "./bin/paykit.mjs"
  },
  "files": [
    "dist",
    "bin/gns.mjs",
    "bin/giftcard.mjs",
    "bin/paykit.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    },
    "./networks": {
      "types": "./dist/networks/index.d.ts",
      "default": "./dist/networks/index.js"
    }
  },
  "scripts": {
    "example:minimal": "tsx examples/minimal-agent/index.ts",
    "example:error-path": "tsx examples/minimal-agent/error-path.ts",
    "example:runtime-store": "tsx examples/minimal-agent/runtime-with-store.ts",
    "example:metrics": "tsx examples/minimal-agent/metrics-prometheus.ts",
    "example:export-tools": "tsx examples/minimal-agent/export-tools.ts",
    "example:x402-eip712": "tsx examples/x402-payment-flow/eip712-full-flow.ts",
    "example:giftcard-purchase": "tsx examples/giftcard-purchase/index.ts",
    "example:gns-register": "tsx examples/gns-register/index.ts",
    "example:gns-x402-register": "tsx examples/gns-x402-register/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc && node scripts/fix-dist-extensions.mjs",
    "pack:smoke": "pnpm run build && node scripts/smoke-test-pack.mjs",
    "smoke:goatflow": "tsx scripts/goatflow-smoke.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm run build",
    "test:unit": "vitest run tests/unit",
    "test": "vitest run tests",
    "test:integration": "vitest run tests/integration",
    "test:redis": "node scripts/test-redis.mjs",
    "cli:gns": "tsx bin/_lib/cli-gns.ts",
    "cli:giftcard": "tsx bin/_lib/cli-giftcard.ts",
    "sync:skill-manifests": "node scripts/sync-skill-manifests.mjs",
    "cli:paykit": "node bin/paykit.mjs",
    "example:paykit": "tsx examples/paykit/index.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ethers": "^6.15.0",
    "goatflow-paykit": "0.4.0",
    "goatflow-sdk": "0.3.0",
    "goatflow-sdk-server": "0.4.0",
    "ioredis": "^5.7.0",
    "viem": "^2.46.3",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "ws": "^8.20.1"
    }
  }
}
